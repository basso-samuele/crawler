{
    "version": 9,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 3,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/bin/${presetName}",
            "warnings": {
                "dev": true,
                "deprecated": true,
                "uninitialized": false,
                "unusedCli": true,
                "systemVars": true
            },
            "errors": {
                "dev": false,
                "deprecated": true
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "hidden": true,
            "configurePreset": "base",
            "cleanFirst": false,
            "verbose": false,
            "jobs": 8
        },
        {
            "name": "debug",
            "inherits": "base",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "inherits": "base",
            "configurePreset": "release"
        }
    ],
    "testPresets": [
        {
            "name": "base",
            "configurePreset": "base",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "inherits": "base"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "inherits": "base"
        }
    ]
}