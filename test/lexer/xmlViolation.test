{"tests": [

{"description":"Non-XML character",
"input":"a\uFFFFb",
"output":[
    ["Character","a"],
    ["Character","\uFFFF"],
    ["Character","b"]
]},

{"description":"Non-XML space",
"input":"a\u000Cb",
"output":[
    ["Character","a"],
    ["Character","\u000C"],
    ["Character","b"]
]},

{"description":"Double hyphen in comment",
"input":"<!-- foo -- bar -->",
"output":[["Comment"," foo -- bar "]]},

{"description":"FF between attributes",
"input":"<a b=''\u000Cc=''>",
"output":[["StartTag","a",{"b":"","c":""}]]}
]}