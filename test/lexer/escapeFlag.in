},TokenizerTest{
    "End tag surrounded by bogus comment in RCDATA or RAWTEXT", // description
    "foo<!--></xmp><!-->baz</xmp>"s, // input
    { // expectedTokens
        CharacterToken{U"f"s},
        CharacterToken{U"o"s},
        CharacterToken{U"o"s},
        CharacterToken{U"<"s},
        CharacterToken{U"!"s},
        CharacterToken{U"-"s},
        CharacterToken{U"-"s},
        CharacterToken{U">"s},
        EndTagToken{U"xmp"},
        CommentToken{U""},
        CharacterToken{U"b"s},
        CharacterToken{U"a"s},
        CharacterToken{U"z"s},
        EndTagToken{U"xmp"},
        EOFToken{}
    },
    LexerState::Rcdata, // initialState
    U"xmp", // lastStartTag
    { // expectedErrors
        { ErrorType::AbruptClosingOfEmptyComment, 19 }
    }
