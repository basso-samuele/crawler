TokenizerTest{
    "Commented close tag in RCDATA or RAWTEXT", // description
    "foo<!--</xmp>--></xmp>"s, // input
    { // expectedTokens
        CharacterToken{U"f"s},
        CharacterToken{U"o"s},
        CharacterToken{U"o"s},
        CharacterToken{U"<"s},
        CharacterToken{U"!"s},
        CharacterToken{U"-"s},
        CharacterToken{U"-"s},
        EndTagToken{U"xmp"},
        CharacterToken{U"-"s},
        CharacterToken{U"-"s},
        CharacterToken{U">"s},
        EndTagToken{U"xmp"},
        EOFToken{}
    },
    LexerState::Rcdata, // initialState
    U"xmp", // lastStartTag
    { // expectedErrors
    }
},TokenizerTest{
    "Commented close tag in RCDATA or RAWTEXT", // description
