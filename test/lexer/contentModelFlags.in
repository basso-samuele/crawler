        CharacterToken{U">"s},
        EOFToken{}
    },
    LexerState::Rcdata, // initialState
    U"xmp", // lastStartTag
    { // expectedErrors
    }
},TokenizerTest{
    "End tag with incorrect name in RCDATA or RAWTEXT (starting like correct name)", // description
    "</foo>bar</xmpaar>"s, // input
    { // expectedTokens
        CharacterToken{U"</foo"s},
        CharacterToken{U">"s},
        CharacterToken{U"b"s},
        CharacterToken{U"a"s},
        CharacterToken{U"r"s},
        CharacterToken{U"</xmpaar"s},
        CharacterToken{U">"s},
