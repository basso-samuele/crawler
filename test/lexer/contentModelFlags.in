    U"xmp", // lastStartTag
    { // expectedErrors
    }
},TokenizerTest{
    "Partial end tags leading straight into partial end tags", // description
    "</xmp</xmp</xmp>"s, // input
    { // expectedTokens
        CharacterToken{U"</xmp"s},
        CharacterToken{U"</xmp"s},
