    LexerState::Rcdata, // initialState
    U"xmp", // lastStartTag
    { // expectedErrors
    }
},TokenizerTest{
    "End tag closing RCDATA or RAWTEXT, switching back to PCDATA", // description
    "foo</xmp></baz>"s, // input
    { // expectedTokens
        CharacterToken{U"f"s},
        CharacterToken{U"o"s},
        CharacterToken{U"o"s},
        EndTagToken{U"xmp"},
        EndTagToken{U"baz"},
        EOFToken{}
    },
    LexerState::Rawtext, // initialState
    U"xmp", // lastStartTag
    { // expectedErrors
    }
},TokenizerTest{
    "RAWTEXT w/ something looking like an entity", // description
    "&foo;"s, // input
    { // expectedTokens
        CharacterToken{U"&"s},
        CharacterToken{U"f"s},
        CharacterToken{U"o"s},
        CharacterToken{U"o"s},
        CharacterToken{U";"s},
        EOFToken{}
    },
    LexerState::Rawtext, // initialState
    U"xmp", // lastStartTag
    { // expectedErrors
    }
},TokenizerTest{
